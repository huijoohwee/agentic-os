{
  "schema": "agentic-os/repository-profile/v1",
  "repository": "github.com/huijoohwee/agentic-os",
  "canonical": {
    "localRef": "refs/heads/main",
    "remoteRef": "refs/remotes/origin/main"
  },
  "adapters": {
    "repository": {
      "id": "git",
      "version": "1"
    },
    "provider": {
      "id": "github",
      "version": "1"
    }
  },
  "requiredChecks": [
    "budgets",
    "test"
  ],
  "capabilities": [
    "deep-byte-audit-opt-in",
    "host-qualified-repository-pin",
    "integration-method:squash",
    "protected-integration:pull-request",
    "quarantine-worktree-cleanup-opt-in",
    "read-only-repository-observation",
    "read-only-review-observation",
    "shallow-observation-default"
  ],
  "authority": {
    "runtime": "consumer",
    "release": "consumer"
  },
  "cleanup": {
    "localBranch": "retain",
    "remoteBranch": "retain",
    "remoteTrackingRef": "retain",
    "unreachableObjects": "retain",
    "worktreeProjection": "quarantine",
    "worktreeRegistration": "quarantine"
  },
  "profileDigest": "ff0fe1d413ab6fe8a4ae09d6b85cf807de432937f841344aa4ec373002a2ad9b"
}
