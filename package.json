{
  "name": "agentic-os",
  "version": "0.1.0",
  "description": "ADLC harness: provider-owned ordering, exact-content integration, zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/governance.mjs",
    "./records": "./src/governance.mjs",
    "./records/authority-evidence": "./src/authority-record.mjs",
    "./records/recovery-candidate": "./src/recovery-candidate.mjs",
    "./adapters/recovery-inventory": "./src/recovery-inventory.mjs",
    "./records/github-authority-issuance": "./src/github-authority-issuer.mjs",
    "./records/completion": "./src/completion.mjs",
    "./adapters/git": "./src/git-repository.mjs",
    "./adapters/github": "./src/github-provider.mjs",
    "./adapters/github-authority": "./src/github-authority.mjs",
    "./adapters/github-authority-issuer": "./src/github-authority-client.mjs",
    "./adapters/github-authority-client": "./src/github-authority-client.mjs",
    "./adapters/github-transition-client": "./src/github-transition-client.mjs",
    "./adapters/github-transition-authority": "./src/github-transition-authority.mjs",
    "./adapters/github-transition-policy": "./src/github-transition-policy.mjs",
    "./adapters/worktree-cleanup": "./src/cleanup.mjs",
    "./compat/git": "./src/compat/git.mjs",
    "./compat/lane-id": "./src/compat/lane-id.mjs",
    "./compat/lane-records": "./src/compat/lane-records.mjs",
    "./compat/worktree": "./src/compat/worktree.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "agentic-os": "bin/agentic-os.mjs",
    "agentic-os-authority": "bin/agentic-os-authority.mjs",
    "agentic-os-transition": "bin/agentic-os-transition.mjs",
    "agentic-os-mcp": "bin/agentic-os-mcp.mjs"
  },
  "files": [
    ".agentic-os.json",
    ".githooks",
    "bin",
    "src",
    "catalog",
    "templates",
    "guides",
    "docs",
    "__tests__",
    "AGENTS.md"
  ],
  "scripts": {
    "setup": "node bin/agentic-os.mjs setup",
    "doctor": "node bin/agentic-os.mjs doctor",
    "lane": "node bin/agentic-os.mjs start",
    "land": "node bin/agentic-os.mjs land",
    "status": "node bin/agentic-os.mjs status",
    "reap": "node bin/agentic-os.mjs reap",
    "sync:canonical": "node bin/agentic-os.mjs canonical-sync",
    "queue:show": "node bin/agentic-os.mjs queue show",
    "queue:apply": "node bin/agentic-os.mjs queue apply",
    "git:configure": "node bin/agentic-os.mjs git-configure",
    "guard:install": "node bin/agentic-os.mjs guard-install",
    "guard:main": "node src/guard-main.mjs",
    "mcp": "node bin/agentic-os-mcp.mjs",
    "feature:rank": "node src/rank.mjs",
    "autonomy:class": "node bin/agentic-os.mjs autonomy-class",
    "observe": "node bin/agentic-os.mjs observe",
    "governance:request": "node bin/agentic-os.mjs request",
    "authority": "node bin/agentic-os-authority.mjs",
    "transition:validate": "node bin/agentic-os-transition.mjs validate-event",
    "readiness:check": "node src/readiness-proof.mjs",
    "composition:runtime:check": "node bin/composition-runtime-check.mjs",
    "composition:admission:probe": "node bin/composition-admission-probe.mjs",
    "docs:check": "node bin/agentic-os-doc-budget.mjs",
    "modules:check": "node bin/agentic-os-module-budget.mjs",
    "evals": "npm run readiness:check && npm run docs:check && npm run modules:check",
    "test": "node --test --test-concurrency=4 __tests__/*.test.mjs",
    "check": "npm test && npm run evals"
  },
  "dependencies": {},
  "devDependencies": {}
}
